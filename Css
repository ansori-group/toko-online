*{
margin:0;
padding:0;
box-sizing:border-box;
font-family:Arial;
}

body{
background:#f5f5f5;
}

header{
display:flex;
align-items:center;
justify-content:space-between;
padding:15px;
background:white;
position:sticky;
top:0;
z-index:1000;
}

.logo{
display:flex;
align-items:center;
gap:10px;
}

.search-box{
display:flex;
width:50%;
}

.search-box input{
width:100%;
padding:10px;
border:1px solid #ddd;
border-radius:20px 0 0 20px;
}

.search-box button{
padding:10px;
border:none;
background:red;
color:white;
border-radius:0 20px 20px 0;
}

.cart i{
font-size:24px;
color:black;
}

.slider{
overflow:hidden;
margin:20px;
border-radius:15px;
}

.slides{
display:flex;
width:300%;
transition:1s;
}

.slides img{
width:100%;
height:250px;
object-fit:cover;
}

.judul{
padding:20px;
}

.produk{
display:grid;
grid-template-columns:repeat(2,1fr);
gap:15px;
padding:15px;
}

.card{
background:white;
padding:10px;
border-radius:12px;
box-shadow:0 0 10px rgba(0,0,0,.1);
}

.card img{
width:100%;
height:180px;
object-fit:cover;
border-radius:10px;
}

.card h3{
margin-top:10px;
}

.rating{
color:orange;
margin:5px 0;
}

.harga{
font-size:18px;
font-weight:bold;
color:red;
}

.coret{
display:block;
text-decoration:line-through;
font-size:14px;
color:gray;
}

.diskon{
background:red;
color:white;
padding:4px 8px;
border-radius:5px;
display:inline-block;
margin:8px 0;
}

.btn{
display:block;
background:green;
color:white;
text-align:center;
padding:10px;
border-radius:8px;
text-decoration:none;
margin-top:10px;
}

.deskripsi{
padding:20px;
line-height:1.8;
}

.deskripsi h2{
margin-top:20px;
color:red;
}

footer{
background:#f44336;
color:white;
padding:30px;
margin-top:30px;
}

.footer-container{
display:grid;
grid-template-columns:repeat(auto-fit,minmax(200px,1fr));
gap:20px;
}

.sosmed a{
color:white;
font-size:24px;
margin-right:10px;
}

iframe{
width:100%;
height:200px;
border:none;
margin-top:10px;
}

.wa-floating{
position:fixed;
right:20px;
bottom:20px;
background:#25D366;
color:white;
width:60px;
height:60px;
display:flex;
justify-content:center;
align-items:center;
border-radius:50%;
font-size:30px;
text-decoration:none;
}

.copyright{
text-align:center;
margin-top:20px;
}
